# Maintainer: Petrus Silva Costa <petrinhu@yahoo.com.br>
pkgname=astrofind
# Arch pkgver cannot contain '-'; use concatenation for pre-release suffix (e.g. 1.0.0beta).
pkgver=1.2.1
pkgrel=1
epoch=0
pkgdesc="Asteroid detection and astrometry for citizen science (IASC/MPC workflow)"
arch=('x86_64')
url="https://github.com/petrinhu/astrofind"
license=('AGPL-3.0-or-later')
depends=(
    'qt6-base'
    'qt6-charts'
    'qtkeychain-qt6'
    'cfitsio'
    'fftw'
    'libarchive'
    'libraw'
)
makedepends=(
    'cmake'
    'ninja'
    'gcc'
    'git'
    'qt6-tools'
    'mesa'
    'desktop-file-utils'
)
optdepends=(
    'qt6-imageformats: 16-bit TIFF images'
    'qt6-wayland: native Wayland sessions'
    'unzip: ZIP image sets'
)
# Source from GitHub tag archive (release.yml places the release's source
# tarball here under the same name, so the CI build uses the exact release
# source without downloading).
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/petrinhu/astrofind/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/astrofind-${pkgver}"
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_INSTALL_RPATH=ON
    cmake --build build
}

check() {
    cd "${srcdir}/astrofind-${pkgver}"
    desktop-file-validate astrofind.desktop
    # Core unit tests (no display needed); the UI suite runs in the QA workflows.
    build/bin/astrofind_tests --reporter compact
}

package() {
    cd "${srcdir}/astrofind-${pkgver}"
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
    install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES" LICENSES/*.txt
}
