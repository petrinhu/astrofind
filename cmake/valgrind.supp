# Valgrind suppressions for AstroFind
# Suppress known false positives from system libraries / Qt internals.

# glibc dl_init / TLS allocations at startup
{
    glibc_dl_init
    Memcheck:Leak
    match-leak-kinds: reachable
    fun:calloc
    fun:_dl_allocate_tls
    fun:allocate_dtv
}

{
    glibc_tls_init
    Memcheck:Leak
    match-leak-kinds: reachable
    fun:malloc
    fun:_dl_map_object_deps
}

# Qt5/6 static init leaks (expected, not real bugs)
{
    qt_static_init
    Memcheck:Leak
    match-leak-kinds: reachable
    fun:malloc
    ...
    obj:*/libQt6Core.so*
}

{
    qt_static_init_new
    Memcheck:Leak
    match-leak-kinds: reachable
    fun:operator new(unsigned long)
    ...
    obj:*/libQt6Core.so*
}

# spdlog registry singleton
{
    spdlog_registry
    Memcheck:Leak
    match-leak-kinds: reachable
    fun:malloc
    ...
    fun:spdlog::details::registry::instance*
}

# zlib / zlib-ng deflate, reached when the QImage loader tests write PNG
# fixtures (AUD-TEST-6). The optimised match finders compare past the
# initialised part of the sliding window by design (documented upstream as a
# valgrind false positive). Only errors whose TOP frame is inside libz are
# suppressed; a bad read in AstroFind or Qt code is still reported.
{
    zlib_deflate_uninit_cond
    Memcheck:Cond
    obj:*/libz*.so*
}

{
    zlib_deflate_uninit_value8
    Memcheck:Value8
    obj:*/libz*.so*
}

# QProcess (ZIP extraction via unzip(1), AUD-MEM-gaps): Qt's forkfd probes
# pidfd support with waitid(P_PIDFD, fd, NULL, ...). A NULL infop is valid on
# Linux (the kernel then skips writing it), but memcheck checks the pointer
# anyway. Only this syscall-parameter report with the call coming from
# libQt6Core is suppressed.
{
   qt_forkfd_waitid_null_infop
   Memcheck:Param
   waitid(infop)
   fun:syscall
   obj:*/libQt6Core.so*
}
